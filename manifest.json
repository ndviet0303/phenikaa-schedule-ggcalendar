{
  "manifest_version": 3,
  "name": "Phenikaa Schedule Dispatcher",
  "version": "1.5.0",
  "description": "Tiện ích bắt payload network, tùy biến thời gian và truy vấn lịch học Phenikaa (Aura Court Edition)",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://qldtbeta.phenikaa-uni.edu.vn/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Schedule Dispatcher"
  },
  "content_scripts": [
    {
      "matches": ["https://qldtbeta.phenikaa-uni.edu.vn/*"],
      "js": [
        "src/core/constants.js",
        "src/core/crypto.js",
        "src/core/ics.js",
        "src/services/storage-service.js",
        "src/services/auth-service.js",
        "src/services/schedule-service.js",
        "src/services/survey-service.js",
        "src/ui/theme.js",
        "src/content/interceptor.js"
      ],
      "css": [
        "src/ui/widget.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://qldtbeta.phenikaa-uni.edu.vn/*"],
      "js": [
        "src/content/bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
